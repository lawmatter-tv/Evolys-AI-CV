# --- OPEN-SOURCE AI ENGINE (ZERO-QUOTA LOCK-IN) ---
# Priority 1: Local or Self-Hosted Open-Source LLM (Ollama, vLLM, LiteLLM, LM Studio)
OPEN_SOURCE_AI_BASE_URL=""
OPEN_SOURCE_AI_API_KEY=""
OPEN_SOURCE_AI_MODEL="qwen2.5:32b"

# Priority 2: Free/Open-Source Inference APIs (Llama 3.3 70B, Qwen 2.5 72B, Mistral)
GROQ_API_KEY=""
HUGGINGFACE_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""

# Optional Cloud Fallback (AI Studio injects GEMINI_API_KEY automatically)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe secret key for live $0.99/mo & $2.99/mo subscription checkout.
STRIPE_SECRET_KEY=""

# AUTH_SESSION_SECRET: Optional HMAC secret for OTP/email account session tokens.
AUTH_SESSION_SECRET=""
